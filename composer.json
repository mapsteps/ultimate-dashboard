{
	"name": "mapsteps/ultimate-dashboard",
	"description": "Ultimate Dashboard – create a custom WordPress dashboard and give the admin area a more meaningful use.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml --exclude=Generic.Files.LineEndings .",
		"fix": "phpcbf --standard=phpcs.xml --exclude=Generic.Files.LineEndings ."
	}
}
